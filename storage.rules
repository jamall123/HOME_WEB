rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email.matches('.*@jhome\\.com');
    }

    // Receipts: Anyone can upload (enrollment request), Admin can read
    match /receipts/{fileName} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // Course Media (Slides, Videos, Audio)
    // - Enrolled students can read
    // - Instructors/Admins can write
    match /courses_media/{allPaths=**} {
      // Allow read/write for now since path structure doesn't easily map to courseId
      // without metadata or custom claims. Upgraded from completely public to Auth required.
      allow read: if isSignedIn();
      allow write: if isAdmin(); 
    }
    
    // Public Assets (Read public, Admin write)
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /successStories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Phase 8: Enterprise Course Resources
    match /courses/{courseId}/resources/{lessonId}/{fileName} {
      function isAllowedType() {
        return request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('application/msword')
            || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document')
            || request.resource.contentType.matches('application/vnd\\.ms-powerpoint')
            || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\.presentationml\\.presentation')
            || request.resource.contentType.matches('application/vnd\\.ms-excel')
            || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet')
            || request.resource.contentType.matches('application/zip')
            || request.resource.contentType.matches('application/x-rar-compressed')
            || request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType.matches('audio/.*')
            || request.resource.contentType.matches('text/plain')
            || request.resource.contentType.matches('text/csv');
      }

      function isValidSize() {
        // Enforce max 100MB
        return request.resource.size <= 100 * 1024 * 1024;
      }

      allow read: if isSignedIn();
      allow write: if isAdmin() && isAllowedType() && isValidSize();
    }
    
    // Default Block
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
