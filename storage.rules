rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{fileName} {
      allow create: if true; // Any user can upload receipt
      allow read: if request.auth != null;
    }
    match /courses_media/{allPaths=**} {
      allow read, write: if true; // Custom Auth implies public read/write for media uploads currently
    }
    match /posts/{allPaths=**} {
      allow read, write: if true;
    }
    match /successStories/{allPaths=**} {
      allow read, write: if true;
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
