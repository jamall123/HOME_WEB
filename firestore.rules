rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks Custom Claims set by Cloud Functions (api_v1_users changeRole action)
    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN') || hasRole('SUPER_ADMIN') || hasRole('admin') || hasRole('super_admin') ||
        // Fallback: email-based (for initial setup before custom claims are set)
        (isSignedIn() && (
          request.auth.token.email == 'jamal@home20.com' ||
          request.auth.token.email == 'admin@sudanfree.com' ||
          request.auth.token.email == 'ja1827082@gmail.com' ||
          request.auth.token.email.matches('.*@jhome\\.com') ||
          request.auth.token.email == 'puppeteer@test.com'
        ));
    }

    function isInstructorRole() {
      return hasRole('INSTRUCTOR') || hasRole('instructor');
    }

    function isEnrolled(courseId) {
      return isSignedIn() &&
        exists(path("/databases/" + database + "/documents/enrollments/" + request.auth.uid + "_" + courseId));
    }

    function isCourseInstructor(courseId) {
      return isInstructorRole() &&
        get(path("/databases/" + database + "/documents/courses/" + courseId)).data.instructorId == request.auth.uid;
    }

    // ── Academy ─────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if true; // Public metadata
      allow write: if isAdmin() || isCourseInstructor(courseId);

      match /connected_users/{userId} {
        allow read: if isAdmin() || isCourseInstructor(courseId) || isEnrolled(courseId);
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
      match /typing_status/{typingId} {
        allow read: if isAdmin() || isCourseInstructor(courseId) || isEnrolled(courseId);
        allow write: if isSignedIn() && request.auth.uid == typingId;
      }
      match /channelMessages/{msgId} {
        allow read: if isEnrolled(courseId) || isCourseInstructor(courseId) || isAdmin();
        allow create: if isEnrolled(courseId) || isCourseInstructor(courseId) || isAdmin();
        allow update, delete: if isAdmin() || isCourseInstructor(courseId);
      }
      match /analytics/{docId} {
        allow read, write: if isCourseInstructor(courseId) || isAdmin();
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && enrollmentId.matches(request.auth.uid + '_.*');
      allow write: if false; // Cloud Functions only
    }

    match /enrollmentRequests/{reqId} {
      allow read, update, delete, create: if isSignedIn();
    }

    match /studentProgress/{docId} {
      allow read: if isAdmin() || 
                  (isSignedIn() && resource != null && isCourseInstructor(resource.data.courseId)) || 
                  (isSignedIn() && docId.matches(request.auth.uid + '_.*'));
      allow write: if isSignedIn() && docId.matches(request.auth.uid + '_.*');
    }

    match /active_sessions/{courseId} {
      allow read: if isAdmin() || isCourseInstructor(courseId) || isEnrolled(courseId);
      allow write: if isAdmin() || isCourseInstructor(courseId);
    }

    match /activeSessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.resource != null && isCourseInstructor(request.resource.data.courseId)) || (isSignedIn() && resource != null && isCourseInstructor(resource.data.courseId));
    }

    match /course_chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isInstructorRole();
    }

    match /curriculum/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstructorRole();
    }

    match /curriculumLessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstructorRole();
    }

    match /lessonResources/{resourceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstructorRole();
    }

    match /certificates/{certId} {
      allow read: if isAdmin() || (isSignedIn() && certId.matches(request.auth.uid + '_.*'));
      allow write: if false; // Only Cloud Functions can generate certificates
    }

    match /courses_credentials/{credId} {
      allow read, write: if isAdmin() || isInstructorRole();
    }

    // ── Missing Academy Features (Analytics, Announcements, Archives) ──
    match /courseAnalytics/{courseId} {
      allow read, write: if isCourseInstructor(courseId) || isAdmin();
    }
    
    match /lessonAnnouncements/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstructorRole();
    }

    match /notifications/{docId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || isInstructorRole();
    }

    match /archived_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstructorRole();
    }

    match /resource_ai_metadata/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstructorRole();
    }

    // ── Missing Audit & Analytics Collections ──
    match /system_audit_logs/{docId} {
      allow read, write: if isAdmin();
    }
    match /curriculumAnalytics/{docId} {
      allow read, write: if isAdmin() || isInstructorRole();
    }
    match /curriculumAuditLogs/{docId} {
      allow read, write: if isAdmin() || isInstructorRole();
    }
    match /curriculumVersions/{docId} {
      allow read, write: if isAdmin() || isInstructorRole();
    }

    // ── CMS (Public Read, Admin Write) ────────────────────────────────────────
    match /posts/{postId}            { allow read: if true; allow write: if isAdmin(); }
    match /stories/{storyId}         { allow read: if true; allow write: if isAdmin(); }
    match /successStories/{storyId}  { allow read: if true; allow write: if isAdmin(); }
    match /projects/{projectId}      { allow read: if true; allow write: if isAdmin(); }
    match /pages/{pageId}            { allow read: if true; allow write: if isAdmin(); }
    match /pageContent/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /bank_accounts/{docId}     { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /newsletter/{docId}        { allow read: if isAdmin(); allow create: if true; allow update, delete: if isAdmin(); }

    // Story Submissions: anyone can submit, only admins can read/update
    match /storySubmissions/{subId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /media_library/{mediaId} {
      allow read: if true;
      // Hard delete allowed directly (triggers mediaController workflow)
      allow delete: if isAdmin();
      // Soft delete / restore = update
      allow update: if isAdmin();
      allow create: if false;
    }

    // ── Settings (Public Read, Admin Write via Functions) ────────────────────
    match /settings/{docId}     { allow read: if true; allow write: if false; }
    match /siteSettings/{docId} { allow read: if true; allow write: if false; }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow update: if isAdmin() || (
        request.auth != null && 
        request.auth.uid == userId && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'specialty', 'bio', 'photo', 'cv'])
      );
      allow create, delete: if isAdmin();
    }

    // ── Contact / Messages ───────────────────────────────────────────────────
    match /messages/{msgId} {
      allow read: if isAdmin();
      // Public can submit contact form (anonymous write is blocked — must be signed in)
      allow create: if isSignedIn();
      allow update, delete: if false;

      match /replies/{replyId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    // Legacy collection — keep readable for any existing data
    match /contactMessages/{msgId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Audit Logs (Read-Only for admins) ────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── System ───────────────────────────────────────────────────────────────
    match /system_config/{docId} { allow read: if true; allow write: if false; }
    match /subscriptions/{subId} { allow read, write: if false; }
    // Idempotency & Rate Limiting: only Cloud Functions (admin SDK) write to these
    match /system_idempotency/{docId} { allow read, write: if false; }
    match /system_rate_limits/{docId} { allow read, write: if false; }

    // (pageContent admin write handled above under CMS section)

    // ── Default: Deny Everything Else ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
