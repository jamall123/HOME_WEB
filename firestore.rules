rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks Custom Claims set by Cloud Functions (api_v1_users changeRole action)
    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN') || hasRole('SUPER_ADMIN') ||
        // Fallback: email-based (for initial setup before custom claims are set)
        (isSignedIn() && (
          request.auth.token.email == 'jamal@home20.com' ||
          request.auth.token.email == 'admin@sudanfree.com' ||
          request.auth.token.email.matches('.*@jhome\\.com')
        ));
    }

    function isInstructorRole() {
      return hasRole('INSTRUCTOR');
    }

    function isEnrolled(courseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId));
    }

    // ── Academy ─────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only

      match /connected_users/{userId} {
        allow read: if isEnrolled(courseId);
        allow write: if isEnrolled(courseId) && request.auth.uid == userId;
      }
      match /typing_status/{typingId} {
        allow read: if isEnrolled(courseId);
        allow write: if isEnrolled(courseId) && typingId.matches('.*_' + request.auth.uid);
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && enrollmentId.matches(request.auth.uid + '_.*');
      allow write: if false; // Cloud Functions only
    }

    match /enrollmentRequests/{reqId} {
      allow read: if isAdmin() || isInstructorRole();
      allow write: if false; // Cloud Functions only
    }

    match /studentProgress/{docId} {
      allow read: if isSignedIn() && (docId.matches(request.auth.uid + '_.*') || isAdmin());
      allow write: if isSignedIn() && docId.matches(request.auth.uid + '_.*');
    }

    match /active_sessions/{courseId} {
      allow read: if isEnrolled(courseId) || isAdmin();
      allow write: if false;
    }

    match /course_chats/{chatId} {
      allow read: if isAdmin() || isInstructorRole();
      allow write: if false;
    }

    match /curriculum/{sectionId} {
      allow read: if isEnrolled(resource.data.courseId) || isAdmin();
      allow write: if false;
    }

    match /curriculumLessons/{lessonId} {
      allow read: if isEnrolled(resource.data.courseId) || isAdmin();
      allow write: if false;
    }

    match /lessonResources/{resourceId} {
      allow read: if isEnrolled(resource.data.courseId) || isAdmin();
      allow write: if false;
    }

    match /courses_credentials/{credId} {
      allow read: if true;
      allow write: if false;
    }

    // ── CMS (Public Read) ────────────────────────────────────────────────────
    match /posts/{postId}            { allow read: if true; allow write: if false; }
    match /stories/{storyId}         { allow read: if true; allow write: if false; }
    match /successStories/{storyId}  { allow read: if true; allow write: if false; }
    match /projects/{projectId}      { allow read: if true; allow write: if false; }
    match /pages/{pageId}            { allow read: if true; allow write: if false; }

    // Story Submissions: anyone can submit, only admins can read/update
    match /storySubmissions/{subId} {
      allow read, update: if isAdmin();
      allow create: if true; // public can submit stories
      allow delete: if isAdmin();
    }

    match /media_library/{mediaId} {
      allow read: if true;
      // Hard delete allowed directly (triggers mediaController workflow)
      allow delete: if isAdmin();
      // Soft delete / restore = update
      allow update: if isAdmin();
      allow create: if false;
    }

    // ── Settings (Public Read, Admin Write via Functions) ────────────────────
    match /settings/{docId}     { allow read: if true; allow write: if false; }
    match /siteSettings/{docId} { allow read: if true; allow write: if false; }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if false;
    }

    // ── Contact / Messages ───────────────────────────────────────────────────
    match /messages/{msgId} {
      allow read: if isAdmin();
      // Public can submit contact form (anonymous write is blocked — must be signed in)
      allow create: if isSignedIn();
      allow update, delete: if false;

      match /replies/{replyId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    // Legacy collection — keep readable for any existing data
    match /contactMessages/{msgId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Audit Logs (Read-Only for admins) ────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── System ───────────────────────────────────────────────────────────────
    match /system_config/{docId} { allow read: if true; allow write: if false; }
    match /subscriptions/{subId} { allow read, write: if false; }

    match /pageContent/{docId} { allow read: if true; allow write: if false; }

    // ── Default: Deny Everything Else ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
