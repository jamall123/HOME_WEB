[debug] [2026-08-16T09:34:57.582Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/jhomeweb-9ee56/rulesets {"name":"projects/jhomeweb-9ee56/rulesets/9074c964-1539-4782-a4e2-3a3bf9b24227","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ── Helper Functions ────────────────────────────────────────────────────\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    // Checks Custom Claims set by Cloud Functions (api_v1_users changeRole action)\n    function hasRole(role) {\n      return isSignedIn() && request.auth.token.role == role;\n    }\n\n    function isAdmin() {\n      return hasRole('ADMIN') || hasRole('SUPER_ADMIN') || hasRole('admin') || hasRole('super_admin') ||\n        // Fallback: email-based (for initial setup before custom claims are set)\n        (isSignedIn() && (\n          request.auth.token.email == 'jamal@home20.com' ||\n          request.auth.token.email == 'admin@sudanfree.com' ||\n          request.auth.token.email == 'ja1827082@gmail.com' ||\n          request.auth.token.email.matches('.*@jhome\\\\.com') ||\n          request.auth.token.email == 'puppeteer@test.com'\n        ));\n    }\n\n    function isInstructorRole() {\n      return hasRole('INSTRUCTOR') || hasRole('instructor');\n    }\n\n    function isEnrolled(courseId) {\n      return isSignedIn() &&\n        exists(path(\"/databases/\" + database + \"/documents/enrollments/\" + request.auth.uid + \"_\" + courseId));\n    }\n\n    function isCourseInstructor(courseId) {\n      return isInstructorRole() &&\n        get(path(\"/databases/\" + database + \"/documents/courses/\" + courseId)).data.instructorId == request.auth.uid;\n    }\n\n    // ── Academy ─────────────────────────────────────────────────────────────\n    match /courses/{courseId} {\n      allow read: if true; // Public metadata\n      allow write: if isAdmin() || isCourseInstructor(courseId);\n\n      match /connected_users/{userId} {\n        allow read: if isAdmin() || isCourseInstructor(courseId) || isEnrolled(courseId);\n        allow write: if isSignedIn() && request.auth.uid == userId;\n      }\n      match /typing_status/{typingId} {\n        allow read: if isAdmin() || isCourseInstructor(courseId) || isEnrolled(courseId);\n        allow write: if isSignedIn() && request.auth.uid == typingId;\n      }\n      match /channelMessages/{msgId} {\n        allow read: if isEnrolled(courseId) || isCourseInstructor(courseId) || isAdmin();\n        allow create: if isEnrolled(courseId) || isCourseInstructor(courseId) || isAdmin();\n        allow update, delete: if isAdmin() || isCourseInstructor(courseId);\n      }\n      match /analytics/{docId} {\n        allow read, write: if isCourseInstructor(courseId) || isAdmin();\n      }\n    }\n\n    match /enrollments/{enrollmentId} {\n      allow read: if isSignedIn() && enrollmentId.matches(request.auth.uid + '_.*');\n      allow write: if false; // Cloud Functions only\n    }\n\n    match /enrollmentRequests/{reqId} {\n      // Only owner can read their own request; admins/instructors can read all\n      allow read: if isAdmin() || isInstructorRole() ||\n        (isSignedIn() && resource != null && resource.data.userId == request.auth.uid);\n      // Only the requesting user can create their own request\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      // Only admins and instructors can approve/reject (update); only admins can delete\n      allow update: if isAdmin() || isInstructorRole();\n      allow delete: if isAdmin();\n    }\n\n    match /studentProgress/{docId} {\n      allow read: if isAdmin() || \n                  (isSignedIn() && resource != null && isCourseInstructor(resource.data.courseId)) || \n                  (isSignedIn() && docId.matches(request.auth.uid + '_.*'));\n      allow write: if isSignedIn() && docId.matches(request.auth.uid + '_.*');\n    }\n\n    match /active_sessions/{courseId} {\n      allow read: if isAdmin() || isCourseInstructor(courseId) || isEnrolled(courseId);\n      allow write: if isAdmin() || isCourseInstructor(courseId);\n    }\n\n    match /activeSessions/{sessionId} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin() || \n                   (isSignedIn() && request.resource != null && isCourseInstructor(request.resource.data.courseId)) || \n                   (isSignedIn() && resource != null && isCourseInstructor(resource.data.courseId)) ||\n                   (isSignedIn() && sessionId.matches('.*_' + request.auth.uid));\n    }\n\n    match /course_chats/{chatId} {\n      allow read: if isAdmin() || isInstructorRole() ||\n        (isSignedIn() && resource != null &&\n          exists(path(\"/databases/\" + database + \"/documents/enrollments/\" + request.auth.uid + \"_\" + resource.data.courseId)));\n      allow create: if isSignedIn() && (\n        isAdmin() || isInstructorRole() ||\n        exists(path(\"/databases/\" + database + \"/documents/enrollments/\" + request.auth.uid + \"_\" + request.resource.data.courseId))\n      ) && request.resource.data.userId == request.auth.uid;\n      allow update, delete: if isAdmin() || isInstructorRole();\n    }\n\n    match /curriculum/{sectionId} {\n      allow read: if isAdmin() || isInstructorRole() ||\n        (isSignedIn() && resource != null &&\n          exists(path(\"/databases/\" + database + \"/documents/enrollments/\" + request.auth.uid + \"_\" + resource.data.courseId)));\n      allow write: if isAdmin() || isInstructorRole();\n    }\n\n    match /curriculumLessons/{lessonId} {\n      allow read: if isAdmin() || isInstructorRole() ||\n        (isSignedIn() && resource != null &&\n          exists(path(\"/databases/\" + database + \"/documents/enrollments/\" + request.auth.uid + \"_\" + resource.data.courseId)));\n      allow write: if isAdmin() || isInstructorRole();\n    }\n\n    match /lessonResources/{resourceId} {\n      allow read: if isAdmin() || isInstructorRole() ||\n        (isSignedIn() && resource != null &&\n          exists(path(\"/databases/\" + database + \"/documents/enrollments/\" + request.auth.uid + \"_\" + resource.data.courseId)));\n      allow write: if isAdmin() || isInstructorRole();\n    }\n\n    match /certificates/{certId} {\n      allow read: if isAdmin() || (isSignedIn() && certId.matches(request.auth.uid + '_.*'));\n      allow write: if false; // Only Cloud Functions can generate certificates\n    }\n\n    match /courses_credentials/{credId} {\n      allow read, write: if isAdmin() || isInstructorRole();\n    }\n\n    // ── Missing Academy Features (Analytics, Announcements, Archives) ──\n    match /courseAnalytics/{courseId} {\n      allow read, write: if isCourseInstructor(courseId) || isAdmin();\n    }\n    \n    match /lessonAnnouncements/{docId} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin() || isInstructorRole();\n    }\n\n    match /notifications/{docId} {\n      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isAdmin() || isInstructorRole();\n    }\n\n    match /archived_sessions/{sessionId} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin() || isInstructorRole();\n    }\n\n    match /resource_ai_metadata/{docId} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin() || isInstructorRole();\n    }\n\n    // ── Missing Audit & Analytics Collections ──\n    match /system_audit_logs/{docId} {\n      allow read, write: if isAdmin();\n    }\n    match /curriculumAnalytics/{docId} {\n      allow read, write: if isAdmin() || isInstructorRole();\n    }\n    match /curriculumAuditLogs/{docId} {\n      allow read, write: if isAdmin() || isInstructorRole();\n    }\n    match /curriculumVersions/{docId} {\n      allow read, write: if isAdmin() || isInstructorRole();\n    }\n\n    // ── CMS (Public Read, Admin Write) ────────────────────────────────────────\n    match /posts/{postId}            { allow read: if true; allow write: if isAdmin(); }\n    match /stories/{storyId}         { allow read: if true; allow write: if isAdmin(); }\n    match /successStories/{storyId}  { allow read: if true; allow write: if isAdmin(); }\n    match /projects/{projectId}      { allow read: if true; allow write: if isAdmin(); }\n    match /pages/{pageId}            { allow read: if true; allow write: if isAdmin(); }\n    match /pageContent/{docId}       { allow read: if true; allow write: if isAdmin(); }\n    match /bank_accounts/{docId}     { allow read: if isAdmin(); allow write: if isAdmin(); }\n    match /newsletter/{docId}        { allow read: if isAdmin(); allow create: if true; allow update, delete: if isAdmin(); }\n\n    // Story Submissions: anyone can submit, only admins can read/update\n    match /storySubmissions/{subId} {\n      allow read, update, delete: if isAdmin();\n      allow create: if true;\n    }\n\n    match /media_library/{mediaId} {\n      allow read: if true;\n      // Hard delete allowed directly (triggers mediaController workflow)\n      allow delete: if isAdmin();\n      // Soft delete / restore = update\n      allow update: if isAdmin();\n      allow create: if false;\n    }\n\n    // ── Settings (Public Read, Admin Write via Functions) ────────────────────\n    match /settings/{docId}     { allow read: if true; allow write: if false; }\n    match /siteSettings/{docId} { allow read: if true; allow write: if false; }\n\n    // ── Users ────────────────────────────────────────────────────────────────\n    match /users/{userId} {\n      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();\n      allow update: if isAdmin() || (\n        request.auth != null && \n        request.auth.uid == userId && \n        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'specialty', 'bio', 'photo', 'cv'])\n      );\n      allow create, delete: if isAdmin();\n    }\n\n    // ── Contact / Messages ───────────────────────────────────────────────────\n    match /messages/{msgId} {\n      allow read: if isAdmin();\n      // Public can submit contact form (anonymous write is blocked — must be signed in)\n      allow create: if isSignedIn();\n      allow update, delete: if false;\n\n      match /replies/{replyId} {\n        allow read: if isAdmin();\n        allow write: if false;\n      }\n    }\n    // Legacy collection — keep readable for any existing data\n    match /contactMessages/{msgId} {\n      allow read: if isAdmin();\n      allow write: if false;\n    }\n\n    // ── Audit Logs (Read-Only for admins) ────────────────────────────────────\n    match /auditLogs/{logId} {\n      allow read: if isAdmin();\n      allow write: if false;\n    }\n\n    // ── System ───────────────────────────────────────────────────────────────\n    match /system_config/{docId} { allow read: if true; allow write: if false; }\n    match /subscriptions/{subId} { allow read, write: if false; }\n    // Idempotency & Rate Limiting: only Cloud Functions (admin SDK) write to these\n    match /system_idempotency/{docId} { allow read, write: if false; }\n    match /system_rate_limits/{docId} { allow read, write: if false; }\n\n    // (pageContent admin write handled above under CMS section)\n\n    // ── Default: Deny Everything Else ───────────────────────────────────────\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-16T09:34:57.030703Z","metadata":{"services":["cloud.firestore"]}}
